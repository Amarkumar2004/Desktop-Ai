# ==============================================================================
# SUSI AI & Agent Town - Environment Configuration Template
# ==============================================================================
# Copy this file to .env.local and fill in your values.
# NEVER commit real secret keys or .env.local to Git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. AI Engine & LLM Providers (Server-side)
# ------------------------------------------------------------------------------
# FreeLLMMap / AI Gateway (Unified Multi-Model Gateway)
FREELLM_API_KEY=
FREELLM_BASE_URL=https://api.freellmmap.com/v1

# Google Gemini API Keys (AI Studio)
GEMINI_API_KEY=
GOOGLE_API_KEY=

# Anthropic Claude API Key
ANTHROPIC_API_KEY=

# OpenAI API Key
OPENAI_API_KEY=

# Groq High-Speed Inference API Key
GROQ_API_KEY=

# OpenRouter Unified Key
OPENROUTER_API_KEY=

# Local Ollama Inference (Optional)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2

# ------------------------------------------------------------------------------
# 2. Voice & Audio Services
# ------------------------------------------------------------------------------
# ElevenLabs Text-to-Speech
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=sTuFDs5r9KT8f6JSiJbq

# Speech-to-Text / Whisper (Optional)
WHISPER_BASE_URL=

# ------------------------------------------------------------------------------
# 3. Supabase Cloud Database & Authentication (Optional for Cloud Sync)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ------------------------------------------------------------------------------
# 4. Agent Town MCP & WebSocket Configuration
# ------------------------------------------------------------------------------
PORT=3000
NEXT_PUBLIC_GATEWAY_URL=
NEXT_PUBLIC_GATEWAY_TOKEN=
AGENT_TOWN_PORT=3000
AGENT_TOWN_DISPATCH_SECRET=
AGENT_TOWN_WORKERS=[]
